name: Build Android APK

on:
workflow_dispatch:

jobs:
build:
runs-on: ubuntu-latest
steps:
- name: Checkout repository
uses: actions/checkout@v4

  - name: Find project ZIP
    id: project
    shell: bash
    run: |
      ZIP="$(find . -type f -name '*.zip' -not -path './.git/*' | head -n 1)"
      if [ -z "$ZIP" ]; then
        echo "No ZIP file found in the repository."
        exit 1
      fi
      echo "zip=$ZIP" >> "$GITHUB_OUTPUT"

  - name: Extract project
    run: |
      mkdir -p extracted
      unzip -o "${{ steps.project.outputs.zip }}" -d extracted

  - name: Set up Java
    uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: "17"

  - name: Build APK
    shell: bash
    run: |
      GRADLEW="$(find extracted -type f -name gradlew | head -n 1)"
      if [ -z "$GRADLEW" ]; then
        echo "No Gradle wrapper found. The ZIP may be a web project, not a native Android project."
        exit 1
      fi
      cd "$(dirname "$GRADLEW")"
      chmod +x gradlew
      ./gradlew assembleDebug

  - name: Upload APK
    if: success()
    uses: actions/upload-artifact@v4
    with:
      name: food-triple-match-apk
      path: extracted/**/build/outputs/apk/debug/*.apk
      if-no-files-found: error
